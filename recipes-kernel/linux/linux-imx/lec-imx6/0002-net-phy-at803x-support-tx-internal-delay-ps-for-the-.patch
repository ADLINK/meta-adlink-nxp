From 8d0002dc6a926cab0b015573a6265be72be9ac51 Mon Sep 17 00:00:00 2001
From: Asuvath MS <asuvath.monikandan@adlinktech.com>
Date: Wed, 30 Sep 2026 16:10:21 +0530
Subject: [PATCH 2/5] net: phy: at803x: support tx-internal-delay-ps for the
Upstream-Status: Inappropriate [ADLINK specific]
 GTX_CLK delay

The AR8031/AR8035 select the RGMII TX clock (GTX_CLK) delay in debug
register 0x0b, bits [6:5]. The default after hardware reset is 2.4 ns.
Boards with longer RGMII traces need a different value. On i.MX6 this
used to be done by a PHY fixup in arch/arm/mach-imx/mach-imx6q.c, which
no longer exists.

Read the standard "tx-internal-delay-ps" property and program the delay
in config_init, so it is applied again after every PHY reset. Only the
two known values are accepted: 1300 (needed by the ADLINK LEC-iMX6) and
2400 (the default).
---
 drivers/net/phy/qcom/at803x.c | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/qcom/at803x.c b/drivers/net/phy/qcom/at803x.c
index 338acd11a9b6..acea84ac7ad1 100644
--- a/drivers/net/phy/qcom/at803x.c
+++ b/drivers/net/phy/qcom/at803x.c
@@ -50,6 +50,14 @@
 #define AT803X_DEBUG_PLL_ON			BIT(2)
 #define AT803X_DEBUG_RGMII_1V8			BIT(3)
 
+/* The GTX_CLK delay, i.e. the RGMII TX clock delay applied while
+ * AT803X_DEBUG_TX_CLK_DLY_EN is set, is selected in debug register 0x0b.
+ * The default after hardware reset is 2.4 ns.
+ */
+#define AT803X_DEBUG_GTX_DLY_MASK		GENMASK(6, 5)
+#define AT803X_DEBUG_GTX_DLY_1300PS		1
+#define AT803X_DEBUG_GTX_DLY_2400PS		2
+
 /* AT803x supports either the XTAL input pad, an internal PLL or the
  * DSP as clock reference for the clock output pad. The XTAL reference
  * is only used for 25 MHz output, all other frequencies need the PLL.
@@ -160,6 +168,7 @@ struct at803x_priv {
 	u16 clk_25m_mask;
 	u8 smarteee_lpi_tw_1g;
 	u8 smarteee_lpi_tw_100m;
+	u8 gtx_dly;
 	bool is_fiber;
 	bool is_1000basex;
 	struct regulator_dev *vddio_rdev;
@@ -284,7 +293,7 @@ static int at803x_parse_dt(struct phy_device *phydev)
 {
 	struct device_node *node = phydev->mdio.dev.of_node;
 	struct at803x_priv *priv = phydev->priv;
-	u32 freq, strength, tw;
+	u32 freq, strength, tw, delay;
 	unsigned int sel;
 	int ret;
 
@@ -313,6 +322,20 @@ static int at803x_parse_dt(struct phy_device *phydev)
 		priv->smarteee_lpi_tw_100m = tw;
 	}
 
+	if (!of_property_read_u32(node, "tx-internal-delay-ps", &delay)) {
+		switch (delay) {
+		case 1300:
+			priv->gtx_dly = AT803X_DEBUG_GTX_DLY_1300PS;
+			break;
+		case 2400:
+			priv->gtx_dly = AT803X_DEBUG_GTX_DLY_2400PS;
+			break;
+		default:
+			phydev_err(phydev, "invalid tx-internal-delay-ps\n");
+			return -EINVAL;
+		}
+	}
+
 	ret = of_property_read_u32(node, "qca,clk-out-frequency", &freq);
 	if (!ret) {
 		switch (freq) {
@@ -483,6 +506,7 @@ static int at803x_hibernation_mode_config(struct phy_device *phydev)
 
 static int at803x_config_init(struct phy_device *phydev)
 {
+	struct at803x_priv *priv = phydev->priv;
 	int ret;
 
 	/* The RX and TX delay default is:
@@ -506,6 +530,15 @@ static int at803x_config_init(struct phy_device *phydev)
 	if (ret < 0)
 		return ret;
 
+	if (priv->gtx_dly) {
+		ret = at803x_debug_reg_mask(phydev, AT803X_DEBUG_REG_HIB_CTRL,
+					    AT803X_DEBUG_GTX_DLY_MASK,
+					    FIELD_PREP(AT803X_DEBUG_GTX_DLY_MASK,
+						       priv->gtx_dly));
+		if (ret < 0)
+			return ret;
+	}
+
 	ret = at803x_smarteee_config(phydev);
 	if (ret < 0)
 		return ret;
-- 
