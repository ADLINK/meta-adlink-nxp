From 598b1101c3ee8c13274899198da52ee4f9e01821 Mon Sep 17 00:00:00 2001
From: "shangavelan.m" <shangavelan.m@adlinktech.com>
Date: Fri, 23 Oct 2026 11:02:56 +0530
Subject: [PATCH] LEC-IMX95: kernel to sm communication for shutdown

Signed-off-by: shangavelan.m <shangavelan.m@adlinktech.com>
Upstream-Status: Inappropriate [board-specific]
---
 .../arm_scmi/vendors/imx/imx-sm-bbm.c         | 22 ++++++++++++
 drivers/gpu/drm/bridge/imx/imx95-mipi-dsi.c   |  4 +--
 .../net/ethernet/freescale/enetc/enetc4_pf.c  |  3 --
 drivers/nvmem/imx-ocotp-ele.c                 |  2 +-
 drivers/rtc/rtc-imx-sm-bbm.c                  | 34 +++++++++++++------
 include/linux/scmi_imx_protocol.h             |  2 ++
 6 files changed, 51 insertions(+), 16 deletions(-)

diff --git a/drivers/firmware/arm_scmi/vendors/imx/imx-sm-bbm.c b/drivers/firmware/arm_scmi/vendors/imx/imx-sm-bbm.c
index aa176c1a5eefe..d9832fb76ebe3 100644
--- a/drivers/firmware/arm_scmi/vendors/imx/imx-sm-bbm.c
+++ b/drivers/firmware/arm_scmi/vendors/imx/imx-sm-bbm.c
@@ -318,6 +318,27 @@ static int scmi_imx_bbm_rtc_alarm_set(const struct scmi_protocol_handle *ph,
 	return ret;
 }
 
+static int scmi_imx_bbm_shutdown_set(const struct scmi_protocol_handle *ph, u32 *state)
+{
+       struct scmi_xfer *t;
+       int ret;
+
+       ret = ph->xops->xfer_get_init(ph, SCMI_IMX_BBM_SHUTDOWN_SET, 0, sizeof(u32), &t);
+       if (ret)
+               return ret;
+
+       /* Polling mode to avoid RCU content switch */
+       t->hdr.poll_completion = true;
+
+       ret = ph->xops->do_xfer(ph, t);
+       if (!ret)
+               *state = get_unaligned_le32(t->rx.buf);
+
+       ph->xops->xfer_put(ph, t);
+
+       return ret;
+}
+
 static int scmi_imx_bbm_button_get(const struct scmi_protocol_handle *ph, u32 *state)
 {
 	struct scmi_xfer *t;
@@ -341,6 +362,7 @@ static const struct scmi_imx_bbm_proto_ops scmi_imx_bbm_proto_ops = {
 	.rtc_time_set = scmi_imx_bbm_rtc_time_set,
 	.rtc_alarm_set = scmi_imx_bbm_rtc_alarm_set,
 	.button_get = scmi_imx_bbm_button_get,
+	.shutdown_set = scmi_imx_bbm_shutdown_set,
 };
 
 static int scmi_imx_bbm_protocol_init(const struct scmi_protocol_handle *ph)
diff --git a/drivers/gpu/drm/bridge/imx/imx95-mipi-dsi.c b/drivers/gpu/drm/bridge/imx/imx95-mipi-dsi.c
index 9c65783a1f227..bedce29b8068a 100644
--- a/drivers/gpu/drm/bridge/imx/imx95-mipi-dsi.c
+++ b/drivers/gpu/drm/bridge/imx/imx95-mipi-dsi.c
@@ -390,7 +390,7 @@ static int imx95_dsi_select_input(struct imx95_dsi *dsi)
 		/* ldb channel1 */
 		port = IMX95_DSI_ENDPOINT_PL1 + PIXEL_LINK_STREAMS;
 		remote_ldb_ch1 = of_graph_get_remote_node(remote1, port, 1);
-		if (!remote_pi1 || remote_ldb_ch1) {
+		if (!remote_pi1) {
 			dev_err(dev, "No valid input endpoint found\n");
 			ret = -EINVAL;
 			goto out;
@@ -878,7 +878,7 @@ imx95_dsi_validate_mode(struct imx95_dsi *dsi, const struct drm_display_mode *mo
 			 * dsi->clk_pixel, we have to validate mode against
 			 * magic mode clock rates.
 			 */
-			if (mode->clock != 297000 && mode->clock != 148500 &&
+			if (mode->clock != 295000 && mode->clock != 154000 && mode->clock != 297000 && mode->clock != 148500 &&
 			    mode->clock != 74250)
 				return MODE_NOCLOCK;
 
diff --git a/drivers/net/ethernet/freescale/enetc/enetc4_pf.c b/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
index c528ca6c501b5..2b5618d781f78 100644
--- a/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
+++ b/drivers/net/ethernet/freescale/enetc/enetc4_pf.c
@@ -2204,9 +2204,6 @@ static struct pci_driver enetc4_pf_driver = {
 	.probe = enetc4_pf_probe,
 	.remove = enetc4_pf_remove,
 	.driver.pm = pm_ptr(&enetc4_pf_pm_ops),
-#ifdef CONFIG_PCI_IOV
-	.sriov_configure = enetc_sriov_configure,
-#endif
 };
 module_pci_driver(enetc4_pf_driver);
 
diff --git a/drivers/nvmem/imx-ocotp-ele.c b/drivers/nvmem/imx-ocotp-ele.c
index bc41e39d7b299..8eb6a9becedd5 100644
--- a/drivers/nvmem/imx-ocotp-ele.c
+++ b/drivers/nvmem/imx-ocotp-ele.c
@@ -406,7 +406,7 @@ static const struct ocotp_devtype_data imx94_ocotp_data = {
  * | 7   | enetc mac vf4     |
  * | 8   | enetc mac vf5     |
  */
-static const u8 imx95_pf_mac_offset_list[] = { 0, 3, 6 };
+static const u8 imx95_pf_mac_offset_list[] = { 0, 1, 2 };
 static const struct ocotp_devtype_data imx95_ocotp_data = {
 	.reg_off = 0x8000,
 	.reg_read = imx_ocotp_reg_read,
diff --git a/drivers/rtc/rtc-imx-sm-bbm.c b/drivers/rtc/rtc-imx-sm-bbm.c
index daa472be7c806..5b6f89d68c633 100644
--- a/drivers/rtc/rtc-imx-sm-bbm.c
+++ b/drivers/rtc/rtc-imx-sm-bbm.c
@@ -9,6 +9,7 @@
 #include <linux/rtc.h>
 #include <linux/scmi_protocol.h>
 #include <linux/scmi_imx_protocol.h>
+#include <linux/reboot.h>
 
 struct scmi_imx_bbm {
 	const struct scmi_imx_bbm_proto_ops *ops;
@@ -112,6 +113,20 @@ static int scmi_imx_bbm_rtc_init(struct scmi_device *sdev)
 	return devm_rtc_register_device(bbnsm->rtc_dev);
 }
 
+static int bbm_poweroff(struct sys_off_data *data)
+{
+       struct scmi_imx_bbm *bbnsm = data->cb_data;
+       struct scmi_protocol_handle *ph = bbnsm->ph;
+       u32 state = 0;
+
+       printk("iMX95: notify System Manager to power off\n");
+
+       bbnsm->ops->shutdown_set(ph, &state);
+       return NOTIFY_DONE;
+}
+
+
+
 static int scmi_imx_bbm_rtc_probe(struct scmi_device *sdev)
 {
 	const struct scmi_handle *handle = sdev->handle;
@@ -119,29 +134,28 @@ static int scmi_imx_bbm_rtc_probe(struct scmi_device *sdev)
 	struct scmi_protocol_handle *ph;
 	struct scmi_imx_bbm *bbnsm;
 	int ret;
-
 	if (!handle)
 		return -ENODEV;
-
 	bbnsm = devm_kzalloc(dev, sizeof(*bbnsm), GFP_KERNEL);
 	if (!bbnsm)
 		return -ENOMEM;
-
 	bbnsm->ops = handle->devm_protocol_get(sdev, SCMI_PROTOCOL_IMX_BBM, &ph);
 	if (IS_ERR(bbnsm->ops))
 		return PTR_ERR(bbnsm->ops);
-
 	bbnsm->ph = ph;
-
 	device_init_wakeup(dev, true);
-
 	dev_set_drvdata(dev, bbnsm);
-
 	ret = scmi_imx_bbm_rtc_init(sdev);
-	if (ret)
+	if (ret) {
 		device_init_wakeup(dev, false);
-
-	return ret;
+		return ret;
+	}
+	ret = devm_register_power_off_handler(dev, bbm_poweroff, bbnsm);
+	if (ret) {
+		dev_err(dev, "Failed to register BBM poweroff handler: %d\n", ret);
+		return ret;
+	}
+	return 0;
 }
 
 static const struct scmi_device_id scmi_id_table[] = {
diff --git a/include/linux/scmi_imx_protocol.h b/include/linux/scmi_imx_protocol.h
index ab867463c08cc..b0083b256f9f3 100644
--- a/include/linux/scmi_imx_protocol.h
+++ b/include/linux/scmi_imx_protocol.h
@@ -21,6 +21,7 @@
 
 #define SCMI_IMX_VENDOR		"NXP"
 #define SCMI_IMX_SUBVENDOR	"IMX"
+#define SCMI_IMX_BBM_SHUTDOWN_SET  0x20U
 
 struct scmi_imx_bbm_proto_ops {
 	int (*rtc_time_set)(const struct scmi_protocol_handle *ph, u32 id,
@@ -30,6 +31,7 @@ struct scmi_imx_bbm_proto_ops {
 	int (*rtc_alarm_set)(const struct scmi_protocol_handle *ph, u32 id,
 			     bool enable, u64 sec);
 	int (*button_get)(const struct scmi_protocol_handle *ph, u32 *state);
+	int (*shutdown_set)(const struct scmi_protocol_handle *ph, u32 *state);
 };
 
 enum scmi_nxp_notification_events {
