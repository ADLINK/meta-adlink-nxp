+int board_phys_sdram_size(phys_size_t *size)
+{
+    ulong sku_cfg;
+    u64 phys_sdram_size, phys_sdram_2_size;
+    if (!size)
+        return -EINVAL;
+
+#ifdef CONFIG_SKUGPIO
+    sku_cfg = ((readl(GPIO5_BASE_ADDR + PDIR) & 0x70) >> 4); // GPIO5_IO_BIT(4~6)
+#endif
+#ifdef CONFIG_SKUADC
+    sku_cfg = sku_adc();
+#endif
+
+    if (sku_cfg == SKU_CFG_DDR_2G) {
+        phys_sdram_size   = 0x70000000; // 2GB
+        phys_sdram_2_size = 0ULL;          // 0GB
+    }
+    else if (sku_cfg == SKU_CFG_DDR_4G) {
+        phys_sdram_size   = 0x70000000; // 2GB
+        phys_sdram_2_size = 0x80000000; // 2GB -> Total 4GB
+    }
+    else if (sku_cfg == SKU_CFG_DDR_8G) {
+        phys_sdram_size   = 0x70000000;  // 2GB
+        phys_sdram_2_size = 0x180000000; // 6GB -> Total 8GB
+    }
+    else if (sku_cfg == SKU_CFG_DDR_16G) {
+        phys_sdram_size   = 0x70000000;  // 2GB
+        phys_sdram_2_size = 0x380000000; // 14GB -> Total 16GB
+    }
+    else {
+        phys_sdram_size   = 0x70000000; // Fallback to 2GB
+        phys_sdram_2_size = 0ULL;
+    }
+
+    *size = phys_sdram_size + phys_sdram_2_size;
+
+    return 0;
+}
