+
+#define SKU_CFG_DDR_2G      0x00
+#define SKU_CFG_DDR_4G      0x01
+#define SKU_CFG_DDR_8G      0x02
+#define SKU_CFG_DDR_16G     0x03
+#endif
+u64 phys_sdram_size=PHYS_SDRAM_SIZE,phys_sdram_2_size=PHYS_SDRAM_2_SIZE;
+#endif
+
 static rom_passover_t rom_passover_data = {0};
 
 uint32_t scmi_get_rom_data(rom_passover_t *rom_data)
@@ -739,7 +759,11 @@ phys_size_t get_effective_memsize(void)
 
 		return sdram_b1_size;
 	} else {
+#ifdef CONFIG_TARGET_LEC_IMX95
+		return phys_sdram_size;
+#else
 		return PHYS_SDRAM_SIZE;
+#endif
 	}
 }
 
@@ -2291,7 +2315,7 @@ bool arch_check_dst_in_secure(void *start, ulong size)
 
 	return false;
 }
-
+/*
 void *arch_get_container_trampoline(void)
 {
 	phys_size_t size;
@@ -2300,4 +2324,45 @@ void *arch_get_container_trampoline(void)
 	size = (size > PHYS_SDRAM_SIZE) ? PHYS_SDRAM_SIZE : size;
 
 	return (void *)((ulong)CFG_SYS_SDRAM_BASE + size - SZ_16M);
+}*/
+
+
+void *arch_get_container_trampoline(void)
+{
+    phys_size_t size;
+#ifdef CONFIG_TARGET_LEC_IMX95
+    ulong sku_cfg = 0;
+    ulong trampoline_sz = SZ_16M;
+
+#ifdef CONFIG_SKUGPIO
+    sku_cfg = ((readl(GPIO5_BASE_ADDR + PDIR) & 0x70) >> 4);
+#endif
+#ifdef CONFIG_SKUADC
+    sku_cfg = sku_adc();
+#endif
+
+    if (sku_cfg == SKU_CFG_DDR_2G) {
+        phys_sdram_size = 0x70000000;
+        phys_sdram_2_size = 0;
+    }
+    else if (sku_cfg == SKU_CFG_DDR_4G) {
+        phys_sdram_size = 0x70000000;
+        phys_sdram_2_size = 0x80000000;
+    }
+    else if (sku_cfg == SKU_CFG_DDR_8G) {
+        phys_sdram_size = 0x70000000;
+        phys_sdram_2_size = 0x180000000;
+    }
+    else if (sku_cfg == SKU_CFG_DDR_16G) {
+        phys_sdram_size = 0x70000000;
+        phys_sdram_2_size = 0x380000000;
+    }
+
+    return (void *)((phys_addr_t)CFG_SYS_SDRAM_BASE + phys_sdram_size - trampoline_sz);
+#else
+    board_phys_sdram_size(&size);
+    size = (size > PHYS_SDRAM_SIZE) ? PHYS_SDRAM_SIZE : size;
+    return (void *)((phys_addr_t)CFG_SYS_SDRAM_BASE + size - SZ_16M);
+#endif
 }
+
