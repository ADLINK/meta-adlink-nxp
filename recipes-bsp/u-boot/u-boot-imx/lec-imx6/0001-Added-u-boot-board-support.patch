diff --git a/board/adlink/lec-imx6/DDR3_2x4Gb-125_Q.cfg b/board/adlink/lec-imx6/DDR3_2x4Gb-125_Q.cfg
new file mode 100644
index 00000000000..17c3638e7cc
--- /dev/null
+++ b/board/adlink/lec-imx6/DDR3_2x4Gb-125_Q.cfg
@@ -0,0 +1,142 @@
+/*
+ * Copyright (C) 2011-2014 Freescale Semiconductor, Inc.
+ * Copyright (C) 2014 LiPPERT ADLINK Technology GmbH
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ *
+ * Refer doc/README.imximage for more details about how-to configure
+ * and create imximage boot image
+ *
+ * The syntax is taken as close as possible with the kwbimage
+ */
+
+//#define __ASSEMBLY__
+#include <config.h>
+/* image version */
+IMAGE_VERSION 2
+
+/*
+ * Boot Device : one of spi, sd, sata
+ * the board has no nand and eimnor
+ * spinor: flash_offset: 0x0400
+ * sata:   flash_offset: 0x0400
+ * sd/mmc: flash_offset: 0x0400
+ */
+#if defined(CONFIG_SYS_BOOT_SPINOR)
+BOOT_FROM      spi
+#elif defined(CONFIG_SYS_BOOT_SATA)
+BOOT_FROM      sata
+#else
+BOOT_FROM      sd
+#endif
+
+#ifdef CONFIG_USE_PLUGIN
+/*PLUGIN    plugin-binary-file    IRAM_FREE_START_ADDR*/
+PLUGIN	board/adlink/lec-imx6/plugin.bin 0x00907000
+#else
+
+#ifdef CONFIG_SECURE_BOOT
+CSF 0x2000
+#endif
+
+/*
+ * Device Configuration Data (DCD)
+ *
+ * Each entry must have the format:
+ * Addr-type           Address        Value
+ *
+ * where:
+ *      Addr-type register length (1,2 or 4 bytes)
+ *      Address   absolute address of the register
+ *      value     value to be stored in the register
+ */
+
+/* configure IOMUXC */
+DATA 4, 0x020e0798, 0x000C0000
+DATA 4, 0x020e0758, 0x00000000
+DATA 4, 0x020e0588, 0x00000000
