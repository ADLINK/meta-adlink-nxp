+#define BMC_I2C_ADDR	0x28
+#define BMC_ALIVE_REG	0x25
+
+static void bmc_send_alive_signal(void)
+{
+	int rc;
+	struct udevice *dev = NULL;
+	uchar bus = 2;
+
+	rc = i2c_get_chip_for_busnum(bus, BMC_I2C_ADDR, 1, &dev);
+	if (rc) {
+		printf("failed to get device for BMC at address 0x%x\n",
+		       BMC_I2C_ADDR);
+	}
+
+	uchar i_am_alive[] = { 1, 0x03 };
+	if (dm_i2c_write(dev, BMC_ALIVE_REG, i_am_alive, sizeof(i_am_alive)))
+		puts("i2c write failed\n");
+}
