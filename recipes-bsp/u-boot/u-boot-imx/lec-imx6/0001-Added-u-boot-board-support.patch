+static const iomux_v3_cfg_t gpio_pads[] = {
+	IOMUX_PADS(PAD_GPIO_3__GPIO1_IO03)      | MUX_PAD_CTRL(NO_PAD_CTRL), /* AEN# */
+	IOMUX_PADS(PAD_GPIO_5__GPIO1_IO05)      | MUX_PAD_CTRL(NO_PAD_CTRL), /* SMARC FORCE_RECOV# */
+	IOMUX_PADS(PAD_GPIO_8__GPIO1_IO08)      | MUX_PAD_CTRL(NO_PAD_CTRL), /* SMARC TEST# */
