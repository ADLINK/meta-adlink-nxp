+static void setup_gpios(void)
+{
+	imx_iomux_v3_setup_multiple_pads(gpio_pads, ARRAY_SIZE(gpio_pads));
+	/* Mux control: 0=SMARC SPI0, 1=I2S0 enabled; GPIO_3 defaults to input
+	 * and AEN# has a PD, so power-up default is SPI0. */
+	gpio_request(GPIO_I2S_AUDIO, "I2S Audio");
+	gpio_request(GPIO_BOOT_TEST, "Boot Test");
+	gpio_request(GPIO_BOOT_RECOVERY, "Boot Recovery");
+	gpio_direction_output(GPIO_I2S_AUDIO, CONFIG_I2S_AUDIO);
+	/* Override bootcmd var; change is temporary unless replacement itself
+	 * contains actual "saveenv" command. In order of increasing priority. */
+	gpio_direction_input(GPIO_BOOT_TEST);
+	if (!gpio_get_value(GPIO_BOOT_TEST))
+		env_set("bootcmd", CONFIG_BOOTCMD_TEST);
+#ifndef CONFIG_ANDROID_RECOVERY
+	gpio_direction_input(GPIO_BOOT_RECOVERY);
+	if (!gpio_get_value(GPIO_BOOT_RECOVERY))
+		env_set("bootcmd", CONFIG_BOOTCMD_FORCE_RECOV);
+#endif
+}
