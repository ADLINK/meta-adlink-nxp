
test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv mmcargs
for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${mmcargs}" != "x"; then
    # skip remaining slots
  elif test "x${BOOT_SLOT}" = "xA"; then
    if test 0x${BOOT_A_LEFT} -gt 0; then
      echo "Found valid slot A, ${BOOT_A_LEFT} attempts remaining"
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      setenv mmcpart 1
      setenv rootpart 2
      setenv mmcargs "setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=/dev/mmcblk${mmcdev}p2 rootwait rw rauc.slot=A"
      echo "${mmcargs}"
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if test 0x${BOOT_B_LEFT} -gt 0; then
      echo "Found valid slot B, ${BOOT_B_LEFT} attempts remaining"
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      setenv mmcpart 3
      setenv rootpart 4
      setenv mmcargs "setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=/dev/mmcblk${mmcdev}p4 rootwait rw rauc.slot=B"
      echo "${mmcargs}"
    fi
  fi
done

if test -n "${mmcargs}"; then
  saveenv
else
  echo "No valid slot found, resetting tries to 3"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

if run loadimage; then
  run mmcboot;
else echo "failed to find a bootable slot!";
fi;
